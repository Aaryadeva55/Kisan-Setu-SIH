# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- PostgreSQL ----
DATABASE_URL="postgresql://user:password@localhost:5432/kisan_setu"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- JWT Secrets ----
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_access_token"
WHATSAPP_APP_SECRET="your_app_secret"
WHATSAPP_VERIFY_TOKEN="your_webhook_verify_token"

# ---- Twilio (voice fallback) ----
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_PHONE_NUMBER="+919876543210"

# ---- External APIs ----
WEATHER_API_KEY="your_weather_api_key"
WEATHER_API_BASE_URL="https://api.example-imd.gov.in"
MANDI_API_KEY="your_mandi_api_key"
MANDI_API_BASE_URL="https://api.data.gov.in/resource/xxxx"

# ---- CORS & Demo ----
CORS_ALLOWED_ORIGIN="http://localhost:5173,http://localhost:3000"
DEMO_MODE=true
SEED_DEMO_DATA=true
